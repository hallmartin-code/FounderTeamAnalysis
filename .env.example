# Copy to .env and fill in. .env is gitignored and .dockerignored.
# In production set these as Railway variables instead - never in a file.

ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-opus-5

# --- web app -------------------------------------------------------------------
# Shared secret for the browser (HTTP Basic; any username, this password).
# Leave blank for localhost. ALWAYS SET IT IN RAILWAY: without it the URL is
# public and every visitor spends your API credit (~$0.15-0.20 per analysis).
APP_PASSWORD=

# Upload ceiling in MB. Image-heavy decks run 50 MB+.
MAX_UPLOAD_MB=64

# How long a finished job and its PDF stay in memory.
JOB_TTL_MINUTES=60
