# Copy to .env and fill in. .env is gitignored and .dockerignored.
# In production set these as Railway variables instead - never in a file.

ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-opus-5

# --- email notification (Resend) -------------------------------------------------
# Leave RESEND_API_KEY unset to disable email entirely. The app still works, and the
# on-page disclosure automatically changes to say nothing is emailed.
RESEND_API_KEY=re_...
RESEND_TO=Info@tencapital.group
# The FROM domain must be verified in Resend or delivery is rejected.
RESEND_FROM=TEN Capital One-Pager <onepager@tencapital.group>
# Attach the raw analysis JSON alongside the PDF.
RESEND_ATTACH_JSON=true

# --- web app ---------------------------------------------------------------------
# Shared secret for the browser (HTTP Basic; any username, this password).
# Leave blank for localhost. ALWAYS SET IT IN RAILWAY: without it the URL is
# public and every visitor spends your API credit (~$0.15-0.20 per analysis).
APP_PASSWORD=

MAX_UPLOAD_MB=64
JOB_TTL_MINUTES=60
